{
  "name": "@aligent/serverless-conventions",
  "version": "1.0.0",
  "description": "A Serverless framework plugin to enforce various formatting conventions to maintain consistency within Serverless applications.",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "jest": {
    "preset": "ts-jest",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublish": "tsc",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/serverless": "^3.12.28",
    "jest": "^30.0.5",
    "ts-jest": "29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "serverless": "3.x || 4.x"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "change-case": "^4.1.2"
  }
}
